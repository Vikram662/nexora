# ==============================================================================
# Docker Compose stack (LiveKit, Redis, Coturn, Egress) - docker/.env
# Copy to docker/.env before `docker compose up`. DEMO values are for local testing only.
# Generate real secrets with:  openssl rand -hex 32
# ==============================================================================

# Must equal LIVEKIT_API_KEY / LIVEKIT_API_SECRET in backend/.env (secret: at least 32 characters).
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=demo-livekit-secret-for-local-dev-0123456789

# Redis is shared by LiveKit and the egress worker. It is bound to 127.0.0.1 only.
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=demo-redis-password-change-me

# Shared secret for TURN credentials (Coturn).
TURN_STATIC_AUTH_SECRET=demo-turn-secret-change-me

# Where LiveKit posts room and recording events. Point it at your backend.
BACKEND_INTERNAL_WEBHOOK_URL=http://127.0.0.1:4000/v1/webhooks/livekit
