# ==============================================================================
# Nexora RTC website and console - frontend/.env.local
# Copy to frontend/.env.local. Values below are DEMO values for local development only.
# ==============================================================================

# ---- API (browser side) -----------------------------------------------------------
# Public URL of the backend. Leave EMPTY when the API is served on the same host as the
# site (the code then uses that host on port 4000 for local development).
# Set it when the API lives on another domain, e.g. https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- API (server side) ------------------------------------------------------------
# Used by the public pages (brand, contact details, pricing) when Next.js fetches on the server.
# Use an internal address if the public URL is not reachable from the server itself.
API_INTERNAL_URL=http://127.0.0.1:4000

# ---- LiveKit ---------------------------------------------------------------------
# WebSocket URL the sandbox connects to. Same as LIVEKIT_URL in the backend.
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# ---- Session verification (REQUIRED) -----------------------------------------------
# Server-only. Must be IDENTICAL to JWT_SECRET in backend/.env, or every /user and /admin
# request is redirected to the login page. Never prefix it with NEXT_PUBLIC_.
JWT_SECRET=demo-jwt-secret-for-local-dev-only-0123456789

# ---- SEO ---------------------------------------------------------------------------
# Public origin of the website: canonical URLs, sitemap.xml, robots.txt, social previews.
# Production example: https://www.yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
