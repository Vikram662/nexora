{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/api",
  "sourceRoot": "apps/api/src",
  "compilerOptions": {
    "builder": "tsc",
    "tsConfigPath": "tsconfig.build.json",
    "deleteOutDir": true,
    "assets": [{ "include": "../../../libs/modules/invoicing/fonts/*.ttf", "outDir": "dist" }]
  },
  "projects": {
    "api": {
      "type": "application",
      "root": "apps/api",
      "entryFile": "apps/api/src/main",
      "sourceRoot": "apps/api/src",
      "compilerOptions": { "tsConfigPath": "tsconfig.build.json" }
    },
    "worker": {
      "type": "application",
      "root": "apps/worker",
      "entryFile": "apps/worker/src/main",
      "sourceRoot": "apps/worker/src",
      "compilerOptions": { "tsConfigPath": "tsconfig.build.json" }
    }
  }
}
