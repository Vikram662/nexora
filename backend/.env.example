# ==============================================================================
# Nexora RTC Control Plane - backend/.env
# Copy to backend/.env. Values below are DEMO values for local development only.
# Generate real secrets for anything that is not your own laptop:  openssl rand -hex 32
# ==============================================================================

# ---- Server -------------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Comma-separated browser origins allowed to call the API (your frontend URL).
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ---- Database (REQUIRED) --------------------------------------------------------
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/nexora_rtc"

# ---- Secrets (REQUIRED, the server refuses to start without them) ---------------
# AES-256-GCM key for stored bucket and Firebase credentials. Exactly 64 hex characters.
# DEMO value below: never reuse it outside local development.
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Signs console session cookies. At least 32 characters. Must equal JWT_SECRET in frontend/.env.local.
JWT_SECRET=demo-jwt-secret-for-local-dev-only-0123456789

# ---- LiveKit (REQUIRED) ---------------------------------------------------------
# Public WebSocket URL of your LiveKit server. Clients connect to it; the backend calls its HTTP API.
# Local:  ws://localhost:7880      Production:  wss://rtc.yourdomain.com
LIVEKIT_URL=ws://localhost:7880
# Must match the key pair your LiveKit server was started with (docker/.env or start-livekit-windows.ps1).
LIVEKIT_API_KEY=devkey
# At least 32 characters.
LIVEKIT_API_SECRET=demo-livekit-secret-for-local-dev-0123456789
# Shown read-only in Admin Settings.
COTURN_HOST=localhost:3478

# ---- Seeding (prisma db seed) ---------------------------------------------------
# Password for the seeded staff accounts. If unset, the seed generates one and prints it once.
# WARNING: the seed deletes existing data first. Never run it against a database you care about.
SEED_STAFF_PASSWORD=

# ---- Staff / operations ---------------------------------------------------------
# Organisation id that staff sessions are bound to. Create it once (the seed does this).
STAFF_OPS_ORG_ID=org_nexora_master_ops
# Name shown in authenticator apps for 2FA.
MFA_ISSUER_NAME=Nexora RTC
# Shown in Admin Settings and on invoices.
COMPANY_LEGAL_NAME="Your Company Private Limited"

# ---- Payments (Razorpay), needed for wallet top-ups ------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Set the same value in the Razorpay dashboard webhook: POST /v1/portal/payments/webhook
RAZORPAY_WEBHOOK_SECRET=demo-razorpay-webhook-secret

# ---- Email (SMTP), optional -----------------------------------------------------
EMAIL_PROVIDER=SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
EMAIL_FROM=billing@yourdomain.com

# ---- SMS, optional ---------------------------------------------------------------
SMS_PROVIDER=FAST2SMS
SMS_API_KEY=
SMS_SENDER_ID=NEXORA

# ---- KYC gateway, optional -------------------------------------------------------
# MOCK accepts format-valid documents and verifies nothing. Use SUREPASS with a token for real checks.
KYC_PROVIDER=MOCK
KYC_ENV=SANDBOX
KYC_API_TOKEN=

# Behind a reverse proxy / load balancer, set the number of proxy hops (e.g. 1) so req.ip is the real client IP.
# TRUST_PROXY=1

# Queue a low wallet balance email when the balance falls below this amount (INR). Default 100.
# LOW_BALANCE_THRESHOLD=100
