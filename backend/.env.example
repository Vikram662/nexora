# ==============================================================================
# Nexora RTC Control Plane — Environment Variables
# ==============================================================================

# Server Port & Environment
PORT=4000
NODE_ENV=development

# Dedicated Staff Operations Organization ID (used for staff audit actions)
STAFF_OPS_ORG_ID=org_nexora_master_ops

# MySQL Database Connection String
DATABASE_URL="mysql://root:@localhost:3306/nexora_rtc"

# 256-bit AES Master Key for BYOS/BYOF Credential Encryption
# REQUIRED: Must be exactly 32 bytes (64 hex characters)
# Generate via: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# JWT Secret for Session Cookies and Portal Authentication
# REQUIRED: Must be at least 32 characters long
# Generate via: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# LiveKit SFU Media Server
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=CHANGE_ME_LIVEKIT_API_SECRET

# Coturn STUN/TURN Server
COTURN_URL=localhost:3478
TURN_STATIC_AUTH_SECRET=CHANGE_ME_TURN_STATIC_AUTH_SECRET

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Company Compliance & Invoicing Details
COMPANY_LEGAL_NAME="Nexora Cloud Infrastructure Private Limited"
COMPANY_GSTIN=
COMPANY_PAN=

# Email & SMS Gateway
EMAIL_PROVIDER=SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

SMS_PROVIDER=FAST2SMS
SMS_API_KEY=
SMS_SENDER_ID=NEXORA

# CORS Allowed Origin (comma-separated origins)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
